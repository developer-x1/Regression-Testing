FROM maven:3.10.0-eclipse-temurin-17-resolute

RUN apt-get update && apt-get install -y jq && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

WORKDIR /home/ubuntu
RUN git clone https://github.com/UT-SE-Research/iDFlakies.git
WORKDIR /home/ubuntu/iDFlakies
RUN mvn clean install -U

WORKDIR /home/ubuntu
RUN git clone https://github.com/TestingResearchIllinois/NonDex.git
WORKDIR /home/ubuntu/NonDex
RUN mvn clean install -U

WORKDIR /home/ubuntu
RUN git clone https://github.com/UT-SE-Research/FlakeSync.git
WORKDIR /home/ubuntu/FlakeSync
RUN mvn clean install -U

WORKDIR /home/ubuntu
RUN rm -rf iDFlakies NonDex FlakeSync

ARG repo
ARG commit

RUN git clone "$repo"
RUN cd "$(basename $repo .git)" && git fetch origin "$commit" && git checkout "$commit"

ENTRYPOINT /usr/local/bin/entrypoint.sh